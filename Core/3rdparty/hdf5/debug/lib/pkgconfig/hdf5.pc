prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/../include

Name: hdf5
Description: HDF5 (Hierarchical Data Format 5) Software Library
Version: 2.1.1

Cflags: "-I${includedir}" 
Libs: "-L${libdir}" -lhdf5
Requires: 
Libs.private: -lm -lws2_32 -lwsock32 -lzd -lsz -laec
Requires.private: 

