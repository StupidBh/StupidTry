prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: hdf5_hl_cpp
Description: HDF5 (Hierarchical Data Format 5) Software Library
Version: 2.1.1


Libs: "-L${libdir}" -lhdf5_hl_cpp
Requires: hdf5_cpp = 2.1.1, hdf5_hl = 2.1.1 hdf5_cpp = 2.1.1, hdf5_hl = 2.1.1
Cflags: "-I${includedir}" 
