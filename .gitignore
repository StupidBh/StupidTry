# === Build outputs ===
/bin/
/build/
cmake-build-*/

# === Compiled intermediates (safety net) ===
*.obj
*.o
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe

# === Vendored dependency binaries ===
# These files are build inputs, not project build outputs.
!/3rdparty/**/*.lib
!/3rdparty/**/*.dll
!/3rdparty/**/*.exe
!/Core/3rdparty/**/*.lib
!/Core/3rdparty/**/*.dll
!/Core/3rdparty/**/*.exe
!/ReaderCGNS/3rdparty/**/*.lib
!/ReaderCGNS/3rdparty/**/*.dll
!/ReaderCGNS/3rdparty/**/*.exe

# === IDE — JetBrains ===
.idea/

# === IDE — Visual Studio ===
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb

# === OS generated ===
Thumbs.db
Desktop.ini
